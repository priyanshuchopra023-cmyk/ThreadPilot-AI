# ThreadPilot AI - Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_DB=threadpilot
POSTGRES_USER=threadpilot
POSTGRES_PASSWORD=threadpilot

# JWT Configuration (REQUIRED - Generate a secure 256-bit key)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# AI Provider Configuration
AI_PROVIDER=nvidia

# NVIDIA AI Configuration
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# Gemini Configuration (Alternative)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-pro

# OCR Configuration
OCR_PROVIDER=mock

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# S3 Configuration (Alternative)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Seed Data
SEED_ENABLED=false